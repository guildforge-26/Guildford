# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. It is already in .gitignore.

# --- Gemini API (scoring calls, free tier) ---
# Get a key at aistudio.google.com -- no Cloud Billing account needed for
# the free tier. See docs/adr/ADR-006-scoring-model-gemini-free-tier.md.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash

# --- Gmail API (read-only alert-email ingestion + draft digests) ---
# Created via Google Cloud Console > OAuth client (Desktop app).
# See README.md "Authorize Gmail" for the one-time browser login flow.
GMAIL_CREDENTIALS_PATH=./gmail_credentials.json
GMAIL_TOKEN_PATH=./gmail_token.json
# The address digests get drafted to (your own inbox).
DIGEST_TO_EMAIL=your-email@example.com

# --- Adzuna job API (Canada endpoint) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Job Bank Canada / Government of Canada / municipal feeds ---
# OPTIONAL and OFF by default: Job Bank does not publish a documented public
# search API for individual postings (only labour-market bulk/open datasets),
# so this needs manual verification before it can be trusted. If you find
# and confirm a real feed URL (RSS/XML/JSON), put it here and the collector
# will start using it; until then it is skipped (logged, not an error).
JOB_BANK_FEED_URL=
GC_JOBS_FEED_URL=

# --- ntfy.sh push notifications ---
# Pick a hard-to-guess private topic name, e.g. tg-jobs-8f2k1
NTFY_TOPIC=

# --- Paths ---
BRIEFING_PATH=./briefing.txt
TARGETS_PATH=./targets.yaml
DB_PATH=./data/jobs.db

# --- Guardrails / cost controls (safe defaults, tune as needed) ---
# MAX_MODEL_CALLS_PER_RUN is deliberately low: gemini-3.6-flash's free tier
# has a per-minute AND a per-day request cap, and third-party reporting
# (not yet confirmed directly against ai.google.dev/gemini-api/docs/rate-limits
# from this environment) puts the newer Gemini 3.x Flash generation's free
# daily quota as low as ~20 requests/day total -- much stricter than older
# Gemini models. With 6 runs/day, 3/run keeps total usage (~18/day, plus 1
# for the daily fractional-CFO scan) under that assumed ceiling with a
# little headroom. CONFIRM the real number for your model at the URL above
# and raise this if you have more room than assumed. A failed call is
# safely retried on the next run (see pipeline.py's postings_needing_scoring),
# so this is a throughput knob, not a correctness one.
MAX_MODEL_CALLS_PER_RUN=3
MAX_RETRIES_PER_SOURCE=3
RUN_TIMEOUT_SECONDS=1200
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_HOURS=24
# Gemini's free tier is $0/call, so these caps should never bind -- they're
# kept as infrastructure in case you ever attach Cloud Billing or switch to
# a paid model. Real cost is always logged to spend_ledger regardless.
DAILY_SPEND_CAP_USD=2.00
MONTHLY_SPEND_CAP_USD=30.00

# --- Scoring thresholds ---
ALERT_SCORE_A=80
ALERT_SCORE_B_MIN=65
TRACK2_ALERT_SCORE=70

# --- Collection window ---
# Look back further than the 4h cron cadence so a missed/late run still
# picks everything up; dedup on canonical URL / company+title+location
# makes re-collecting the same posting a no-op.
COLLECT_LOOKBACK_HOURS=26

# --- Scheduling ---
TIMEZONE=America/Edmonton
DIGEST_HOUR_AM=7
DIGEST_HOUR_PM=16
